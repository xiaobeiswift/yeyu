# Local Y3/Codex toolchain. Its exact revision is recorded in toolchain.lock.
/.y3maker/

# Editor/session state.
/lock/
/archive/archive_storage.json
/.vscode/
**/.log/
**/log/
*.log

# Third-party editor preset content is not part of the original game source.
/plugins/

# Temporary and test output.
*.tmp
*.bak
*.swp
*.pyc
*~
Thumbs.db
.DS_Store
**/__pycache__/
/.idea/
/tmp/
/test-results/
/coverage/

# Local external toolchain binaries and dependencies under tools/.
# Only hand-written scripts (e.g. tools/serve_opening_video.js, tools/test.ps1) are tracked.
/tools/ffmpeg/
/tools/ffmpeg-bin/
/tools/node_modules/
/tools/ffmpeg.exe
/tools/ff.exe
/tools/ffmpeg.zip
/tools/ff.err.txt
/tools/ff_ver.txt
/tools/ff_ver_err.txt
